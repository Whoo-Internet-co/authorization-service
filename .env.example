# Identidade
SERVICE_NAME=authorization-service
PORT=3000

# AWS (produção usa Task Role; local usa credenciais estáticas)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint custom (DynamoDB Local / LocalStack). Vazio em produção.
DYNAMODB_ENDPOINT=http://localhost:8000

# Persistência
ADAPTER_MODE=dynamodb            # dynamodb | in-memory (sem infra, para demo)
DYNAMODB_TABLE=authorization-service
DYNAMODB_CHECKPOINT_TABLE=authorization-service-checkpoint
IDEMPOTENCY_TTL_SECONDS=86400

# Circuit breaker (configuração simples: limiar de falhas consecutivas + força abertura)
CIRCUIT_BREAKER_FORCE_OPEN=false
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=30000

# Eventos / Outbox relay
# Schema oficial vem do package @whoo-internet-co/finance-platform-contracts (ADR-008).
# CONTRACTS_SCHEMA_PATH é opcional (override); se vazio, resolve o export do package.
CONTRACTS_SCHEMA_PATH=
EVENT_BUS_NAME=default
EVENT_SOURCE=authorization-service
RELAY_PUBLISHER=local-sqs          # eventbridge | local-sqs
LOCAL_SQS_QUEUE_URLS=http://localhost:9324/000000000000/fraud-queue,http://localhost:9324/000000000000/accounting-queue,http://localhost:9324/000000000000/notification-queue
RELAY_POLL_INTERVAL_MS=1000
RELAY_BATCH_SIZE=100